# EditorConfig — https://editorconfig.org
# sui house style: TAB characters, rendered 2 columns wide.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

# JSON consumed by tooling that expects spaces (npm/bun accept tabs, but
# generated lockfiles and package manifests stay space-indented)
[{package.json,package-lock.json,bun.lock,components.json}]
indent_style = space
indent_size = 2

# markdown: trailing double-space = hard line break
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4
